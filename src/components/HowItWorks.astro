---
import ProductDemo from './ProductDemo.astro';
import type { LocalizedPageCopy } from '../i18n/site';

interface Props {
  copy: LocalizedPageCopy['howItWorks'];
}

const { copy } = Astro.props;
---

<section class="px-6 py-24 md:px-12 max-w-7xl mx-auto">
  <div class="mb-16">
    <p class="text-tertiary text-xs font-headline tracking-[0.2em] uppercase font-semibold mb-4">
      {copy.eyebrow}
    </p>
    <h2 class="font-headline text-3xl md:text-5xl font-extrabold tracking-display max-w-lg leading-tight">
      {copy.title.line1}<br />{copy.title.line2}
    </h2>
  </div>

  <div class="flex flex-col md:flex-row md:items-center gap-10 md:gap-8">
    <!-- Steps — the active one follows the product demo -->
    <div class="flex-1 space-y-5">
      {copy.steps.map((step, i) => (
        <div
          data-demo-step={i}
          class={`demo-step bg-surface-container-low p-8 rounded-3xl ring-1 ring-transparent transition-all duration-500 hover:bg-surface-container ${step.offset ? 'md:ml-12' : ''}`}
        >
          <div class="flex items-start gap-4">
            <span
              class={`material-symbols-outlined text-4xl ${step.color} shrink-0`}
              style="font-variation-settings: 'FILL' 1;"
            >
              {step.icon}
            </span>
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-headline font-bold tracking-widest uppercase text-on-surface-variant">
                  {copy.stepLabel} {i + 1}
                </span>
              </div>
              <h3 class="font-bold text-xl mb-2 font-headline">{step.title}</h3>
              <p class="text-on-surface-variant leading-relaxed">{step.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Animated product demo in a phone frame -->
    <div class="order-first md:order-last flex-1 flex justify-center">
      <ProductDemo copy={copy.demo} />
    </div>
  </div>
</section>

<style>
  .demo-step.is-active {
    @apply bg-surface-container ring-primary/40;
    box-shadow: 0 0 40px rgba(139, 0, 255, 0.12);
  }
</style>

<script>
  // ProductDemo announces which step its animation is showing
  const steps = document.querySelectorAll<HTMLElement>('[data-demo-step]');
  window.addEventListener('demo:step', (event) => {
    const active = (event as CustomEvent<number>).detail;
    steps.forEach((el) => el.classList.toggle('is-active', Number(el.dataset.demoStep) === active));
  });
</script>
